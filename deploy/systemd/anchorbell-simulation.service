[Unit]
Description=AnchorBell M1-M9 simulated trading batch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=anchorbell
Group=anchorbell
WorkingDirectory=/var/lib/anchorbell
ExecStart=/opt/anchorbell/target/release/anchorbell_simulation_batch --strategy-profile /opt/anchorbell/config/anchorbell-simulation.json
# Exit status 2 is the deterministic storage safety stop. Do not spin while
# the host is below the minimum free-space floor.
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
